{
    "apiVersion": 3,
    "name": "orb/grid",
    "version": "1.0.0",
    "title": "Grid",
    "category": "layout",
    "icon": "grid-view",
    "description": "Lay out cells on a responsive CSS grid.",
    "supports": {
        "html": false,
        "align": [
            "wide",
            "full"
        ],
        "background": {
            "backgroundImage": true,
            "backgroundSize": true,
            "__experimentalDefaultControls": {
                "backgroundImage": true
            }
        },
        "color": {
            "background": true,
            "text": true
        },
        "__experimentalBorder": {
            "radius": true
        },
        "orbitools": {
            "spacings": {
                "breakpoints": true,
                "gap": true,
                "margin": false,
                "padding": true
            }
        }
    },
    "attributes": {
        "columnSystem": {
            "type": "number",
            "default": 12,
            "enum": [
                5,
                12
            ]
        },
        "stackOnMobile": {
            "type": "boolean",
            "default": true
        }
    },
    "providesContext": {
        "orb/columnSystem": "columnSystem",
        "orb/stackOnMobile": "stackOnMobile"
    },
    "textdomain": "orbitools",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./editor.css",
    "style": "file:./index.css"
}
