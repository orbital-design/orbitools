{
  "$schema": "https://orbitools/schemas/module.v1.json",
  "slug": "core-overrides",
  "name": "Core Cleanup",
  "description": "Strip out built-in WordPress pages and post types the site doesn't use.",
  "version": "1.0.0",
  "category": "modules",
  "class": "\\Orbitools\\Modules\\Core_Overrides\\Core_Overrides",
  "default_enabled": false,
  "section_layout": "stacked",
  "requires": {
    "php": ">=7.4",
    "wp": ">=5.0"
  },
  "sections": [
    {
      "id": "content",
      "title": "Content",
      "description": "Hide built-in content types the site doesn't use."
    },
    {
      "id": "admin_features",
      "title": "Admin features",
      "description": "Wholesale admin features the site doesn't need."
    },
    {
      "id": "settings_pages",
      "title": "Settings Pages",
      "description": "Toggle off pages under the WP admin Settings menu."
    },
    {
      "id": "tools_pages",
      "title": "Tools Pages",
      "description": "Toggle off pages under the WP admin Tools menu."
    }
  ],
  "settings": [
    {
      "id": "disable_posts",
      "type": "toggle",
      "label": "Disable posts entirely",
      "description": "Removes the Posts admin menu, the '+ New → Post' admin bar item, unregisters the post_tag taxonomy from posts, and bounces any post / category / tag editing screen back to the dashboard. Use on sites that only use custom post types. (Default on — Orbital sites never use the default blog.)",
      "default": true,
      "section": "content"
    },
    {
      "id": "disable_customizer",
      "type": "toggle",
      "label": "Disable the Customizer",
      "description": "Removes the Customizer entirely — the admin menu entry, the toolbar shortcut, and direct customize.php access. Use on sites whose chrome is managed via theme code, theme.json, or our Site Settings page. (Default on — Orbital sites don't use the Customizer.)",
      "default": true,
      "section": "admin_features"
    },
    {
      "id": "disable_widgets",
      "type": "toggle",
      "label": "Disable widgets",
      "description": "Hides the Appearance → Widgets menu, blocks direct widgets.php access, and removes the Customizer's Widgets panel. Block themes and most modern designs don't use widgets; turn this on to keep the admin tidy. (Default on — Orbital sites don't use widgets.)",
      "default": true,
      "section": "admin_features"
    },
    {
      "id": "disable_general",
      "type": "toggle",
      "label": "Disable General",
      "description": "options-general.php",
      "default": false,
      "section": "settings_pages"
    },
    {
      "id": "disable_writing",
      "type": "toggle",
      "label": "Disable Writing",
      "description": "options-writing.php",
      "default": false,
      "section": "settings_pages"
    },
    {
      "id": "disable_connectors",
      "type": "toggle",
      "label": "Disable Connectors",
      "description": "options-connectors.php (added in WP 7.0).",
      "default": false,
      "section": "settings_pages"
    },
    {
      "id": "disable_reading",
      "type": "toggle",
      "label": "Disable Reading",
      "description": "options-reading.php",
      "default": false,
      "section": "settings_pages"
    },
    {
      "id": "disable_discussion",
      "type": "toggle",
      "label": "Disable Discussion",
      "description": "options-discussion.php",
      "default": false,
      "section": "settings_pages"
    },
    {
      "id": "disable_media",
      "type": "toggle",
      "label": "Disable Media",
      "description": "options-media.php",
      "default": false,
      "section": "settings_pages"
    },
    {
      "id": "disable_permalinks",
      "type": "toggle",
      "label": "Disable Permalinks",
      "description": "options-permalink.php",
      "default": false,
      "section": "settings_pages"
    },
    {
      "id": "disable_privacy",
      "type": "toggle",
      "label": "Disable Privacy",
      "description": "options-privacy.php",
      "default": false,
      "section": "settings_pages"
    },
    {
      "id": "disable_available_tools",
      "type": "toggle",
      "label": "Disable Available Tools",
      "description": "tools.php",
      "default": false,
      "section": "tools_pages"
    },
    {
      "id": "disable_import",
      "type": "toggle",
      "label": "Disable Import",
      "description": "import.php",
      "default": false,
      "section": "tools_pages"
    },
    {
      "id": "disable_export",
      "type": "toggle",
      "label": "Disable Export",
      "description": "export.php",
      "default": false,
      "section": "tools_pages"
    },
    {
      "id": "disable_site_health",
      "type": "toggle",
      "label": "Disable Site Health",
      "description": "site-health.php",
      "default": false,
      "section": "tools_pages"
    },
    {
      "id": "disable_export_personal_data",
      "type": "toggle",
      "label": "Disable Export Personal Data",
      "description": "export-personal-data.php",
      "default": false,
      "section": "tools_pages"
    },
    {
      "id": "disable_erase_personal_data",
      "type": "toggle",
      "label": "Disable Erase Personal Data",
      "description": "erase-personal-data.php",
      "default": false,
      "section": "tools_pages"
    }
  ]
}
